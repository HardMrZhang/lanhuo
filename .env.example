# .env.example — 复制为 .env 后填写（EC2 上用 scp 单独传，不进 git）
PORT=3001
APP_URL=https://your-domain.example
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

VAEHUB_API_BASE=
VAEHUB_APP_TAG=project
VAEHUB_APP_KEY=
VAEHUB_APP_SECRET=
VAEHUB_CURRENCY=USD
VAEHUB_COUNTRY=
# VAEHUB_PAYCODE=
# VAEHUB_USDT_RATES_JSON={"USD":1}
VAEHUB_RETURN_TYPE=cashier

# HLS / S3：EC2 挂 IAM Role 后可留空 AK/SK（SDK 自动用实例角色），本地上传才需要填
S3_BUCKET=duanju-h5-hls-473041657070
AWS_REGION=ap-northeast-1
S3_PREFIX=hls
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# MySQL 会员库（EC2 本机或 RDS）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=duanju_h5

MEDIA_DIR=./media
DATA_FILE=./data/dramas.json

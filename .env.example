# .env.example — 复制为 .env 后填写（EC2 上用 scp 单独传，不进 git）
PORT=3001
APP_URL=https://your-domain.example
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false

VAEHUB_API_BASE=
VAEHUB_APP_TAG=project
VAEHUB_APP_KEY=
VAEHUB_APP_SECRET=
VAEHUB_CURRENCY=USD
VAEHUB_COUNTRY=            # ISO3 三字母国家码，如 USA / SGP（代收必填）
# VAEHUB_PAYCODE=          # 支付方式代码，如 PAYNOW_B2C、CASHAPP；不填则自动选择
VAEHUB_USDT_RATES_JSON='{"USD":1}'  # 必填：1 USDT 兑换多少法币，如 {"USD":1}
VAEHUB_RETURN_TYPE=cashier
# VaeHub 测试环境。官方文档写明 Sandbox / Product Base url 均需向商务索取，未公开沙箱域名，
# 因此沙箱地址完全由配置决定。开启后优先使用 VAEHUB_SANDBOX_API_BASE。
# 测试环境的 App Secret 与生产不同（实测生产 Secret 在沙箱验签报 Signature verification failed.）。
# VAEHUB_SANDBOX_API_BASE=https://sandbox.example.com/api
# VAEHUB_SANDBOX=false
# VAEHUB_SANDBOX_APP_KEY=
# VAEHUB_SANDBOX_APP_SECRET=
# VAEHUB_MOCK_RES=success       # 仅测试环境有效：让通道直接返回该状态，不真实收款
# 自检：node --env-file-if-exists=.env scripts/vaehub-probe.mjs  （加 --ping 只验签）

# BSC 链自建固定收款地址（BEP-20 USDT）。配置收款地址后自动启用该支付通道。
# 所有订单共用这一个地址，靠「套餐价 + 唯一尾数偏移」区分订单，链上确认后自动开通会员。
# BSC_PAY_ADDRESS=0x...
BSC_TOKEN_CONTRACT=0x55d398326f99059fF775485246999027B3197955
BSC_TOKEN_SYMBOL=USDT
BSC_TOKEN_DECIMALS=18
BSC_CHAIN_ID=56
BSC_DISPLAY_DECIMALS=4          # 应付金额固定 4 位小数，尾数即订单标识
BSC_OFFSET_MAX_STEPS=100        # 尾数偏移步数上限：最多比套餐价多 0.01 USDT
BSC_CONFIRMATIONS=15
BSC_POLL_INTERVAL_MS=15000
BSC_ORDER_TTL_MS=900000           # 订单有效期 15 分钟，过期作废（前端有倒计时）
BSC_LATE_PAYMENT_WINDOW_MS=21600000  # 订单过期后仍认领迟到转账的宽限期（6 小时）
BSC_LOOKBACK_BLOCKS=200
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.defibit.io

# HLS / S3：EC2 挂 IAM Role 后可留空 AK/SK（SDK 自动用实例角色），本地上传才需要填
S3_BUCKET=duanju-h5-hls-473041657070
AWS_REGION=ap-northeast-1
S3_PREFIX=hls
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# MySQL 会员库（EC2 本机或 RDS）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=duanju_h5

# ---------- 账号增强能力 ----------
# 图形验证码：AUTH_CAPTCHA=off 可关闭（仅建议开发/内网环境）。
AUTH_CAPTCHA=on

# 邮件（SMTP）：配置后自动启用「邮箱验证」与「密码找回」。
# 未配置时这两项功能关闭，注册直接视为已验证。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@your-domain.example

MEDIA_DIR=./media
DATA_FILE=./data/dramas.json
# VIP_PLANS_JSON=[{"id":"month","name":"月度会员","days":30,"price":10,"currency":"USDT","recommended":false},{"id":"halfyear","name":"半年会员","days":180,"price":20,"currency":"USDT","recommended":true},{"id":"year","name":"年度会员","days":365,"price":30,"currency":"USDT","recommended":false}]

{
  "name": "duanju-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vue-tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview",
    "hls": "bash scripts/to-hls.sh",
    "hls:py": "bash scripts/transcode-py-download.sh",
    "db:init": "node --env-file-if-exists=.env scripts/init-mysql-dramas.mjs",
    "import:py-mysql": "node --env-file-if-exists=.env scripts/import-py-download-mysql.mjs --apply",
    "gen:mock": "node scripts/gen-mock.mjs",
    "import:downloads": "node scripts/import-downloads.mjs",
    "import:manifest": "node scripts/gen-import-manifest.mjs",
    "download:authorized": "node scripts/download-authorized-media.mjs",
    "covers:sync": "node scripts/sync-covers.mjs",
    "video:map": "node scripts/video-import-map.mjs",
    "video:transcode": "node scripts/video-transcode.mjs",
    "video:covers": "node scripts/video-covers.mjs --apply",
    "video:s3": "node scripts/video-upload-s3.mjs",
    "video:db": "node --env-file-if-exists=.env scripts/video-import-mysql.mjs --apply",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "hls.js": "^1.5.20",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
